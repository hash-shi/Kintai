				<param name="format">yyyy/MM</param>
			</check>
		</variable>
		<variable name="dummy" dispName="">
			<check class="SizeComparison" message="対象年月度FROM-TOの大小が不正です。" itemName="{dispName}">
				<param name="from">srhTxtTaishoNengetsuF</param>
				<param name="to">srhTxtTaishoNengetsuT</param>
				<param name="include">1</param>
			</check>
		</variable>
		<variable name="srhTxtEigyoshoCodeF" dispName="営業所コードFROM">
			<check class="IsNumeric" message="!#itemName#!には数字を入力してください。" itemName="{dispName}"></check>
